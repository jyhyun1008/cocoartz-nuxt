# 이 파일(.env)은 로컬에서 `nuxt dev`/`nuxt build`를 직접 돌릴 때만 쓰입니다 — Nuxt가
# 빌드/개발 서버 실행 시점에 자동으로 읽어서 nuxt.config.ts의 process.env.X 값에 반영해줌.
#
# ⚠️ 도커로 배포할 때는 이 파일 그대로 쓰면 안 됩니다. .dockerignore가 .env를 빌드 컨텍스트에서
# 빼기 때문에(의도적 — 이미지에 시크릿이 그대로 굳는 걸 방지) docker build 시점엔 이 값들이
# 전부 빈 값으로 이미지에 고정돼버리고, 그 뒤 docker-compose의 environment:로 DOMAIN=... 처럼
# 줘봤자 무시됩니다(nuxt.config.ts의 runtimeConfig는 빌드 시점 값이 굳고, 컨테이너 실행 시점엔
# NUXT_ 접두사가 붙은 이름으로만 덮어쓸 수 있음). 도커 배포는 docker-compose.yml에 이미
# NUXT_DOMAIN/NUXT_PUBLIC_API_BASE_URL/NUXT_PUBLIC_SERVER_SLUG 등으로 맞춰뒀으니 그걸 쓰세요.
DATABASE_URL=postgresql://cocoartz:cocoartz@localhost:5432/cocoartz
# 내부 /api/* 호출에 쓰이는 prefix (프로토콜 포함). 프로덕션에서는 보통 https://${DOMAIN}과 같은 값.
API_BASEURL=http://localhost:3000
SERVER_SLUG=cocoartz
# 서버의 공개 도메인 (프로토콜 제외). 페디버스 연합(webfinger/ActivityPub)에 사용되며
# 프로덕션에서는 HTTPS로 외부에서 접근 가능해야 함
DOMAIN=yourdomain.com

# 오브젝트 스토리지 (선택 — S3 호환: MinIO/Cloudflare R2/AWS S3 등. 전부 비워두면 업로드 기능 없이
# 아바타/서버아이콘을 URL로만 지정 가능)
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=auto
# S3_BUCKET=cocoartz
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false
